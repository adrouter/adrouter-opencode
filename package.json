{
  "name": "@adrouter/opencode",
  "version": "0.1.0-beta.3",
  "description": "AdRouter provider and tiered sponsorship panel for OpenCode",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "release-manifest.json",
    "RELEASE.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrouter/adrouter-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/adrouter/adrouter-opencode/issues"
  },
  "homepage": "https://github.com/adrouter/adrouter-opencode#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "candidate"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "opencode": ">=1.18.4 <2"
  },
  "scripts": {
    "clean": "bun scripts/clean.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "audit": "bun scripts/audit.ts",
    "package:check": "bun scripts/package-check.ts",
    "plugin:check": "bun scripts/opencode-model-check.ts",
    "release:check": "bun scripts/release-check.ts",
    "prepack": "bun run clean && bun run build"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.4 <2",
    "@opentui/core": ">=0.4.5 <1",
    "@opentui/solid": ">=0.4.5 <1",
    "solid-js": ">=1.9.12 <2"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@opencode-ai/plugin": "1.18.4",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.3.14",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "keywords": [
    "opencode",
    "ai-sdk",
    "adrouter",
    "provider"
  ]
}
